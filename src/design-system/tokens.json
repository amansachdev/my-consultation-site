{
  "name": "Antaran Design Tokens",
  "version": "0.1.0",
  "description": "Single source of truth for colors, typography, spacing, and elevation used across the Antaran mental-health platform.",
  "colors": {
    "brand": {
      "forest": "#2E4F43",
      "leaf": "#6B8A75",
      "sage": "#E8EEE4",
      "sand": "#F6F4EF",
      "gold": "#C8A67C",
      "coral": "#C4745C"
    },
    "neutral": {
      "ink": "#20201D",
      "slate": "#4A4A46",
      "mist": "#F6F7F3",
      "line": "#DFE3DA",
      "white": "#FFFFFF"
    },
    "semantic": {
      "success": "#4A7C59",
      "warning": "#D4A056",
      "danger": "#B5423F",
      "info": "#4A6D8C",
      "calm": "#6B8A75"
    }
  },
  "typography": {
    "family": {
      "sans": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"],
      "serif": ["Fraunces", "Georgia", "serif"]
    },
    "size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem",
      "6xl": "3.75rem"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "snug": 1.4,
      "normal": 1.6,
      "relaxed": 1.8
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem"
  },
  "radii": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "2xl": "1rem",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(32, 32, 29, 0.04)",
    "DEFAULT": "0 4px 12px rgba(32, 32, 29, 0.06)",
    "md": "0 8px 24px rgba(32, 32, 29, 0.08)",
    "lg": "0 18px 45px rgba(32, 32, 29, 0.12)",
    "focus": "0 0 0 4px rgba(107, 138, 117, 0.15)"
  }
}
